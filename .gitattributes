# Store and check out text with LF endings, whatever core.autocrlf says.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything below goes through LFS. No lockable: the team is small.

# ---- Original C&C data (Westwood formats) ----
# From the 2007 freeware release of C&C Gold. MIX files are archives; SHP, PAL, AUD,
# VQA and the rest may also be committed after extraction.
# The original file names are upper case. core.ignorecase lets CONQUER.MIX match *.mix
# on Windows but not on Linux or macOS, so lower-case the names before committing.
# A map is an .ini (text, stays in git) plus a .bin of the same name (terrain, LFS).
*.mix     filter=lfs diff=lfs merge=lfs -text
*.shp     filter=lfs diff=lfs merge=lfs -text
*.pal     filter=lfs diff=lfs merge=lfs -text
*.aud     filter=lfs diff=lfs merge=lfs -text
*.vqa     filter=lfs diff=lfs merge=lfs -text
*.vqp     filter=lfs diff=lfs merge=lfs -text
*.cps     filter=lfs diff=lfs merge=lfs -text
*.wsa     filter=lfs diff=lfs merge=lfs -text
*.fnt     filter=lfs diff=lfs merge=lfs -text
*.bin     filter=lfs diff=lfs merge=lfs -text
# Terrain templates take the theater as extension: temperate, winter, desert.
*.tem     filter=lfs diff=lfs merge=lfs -text
*.win     filter=lfs diff=lfs merge=lfs -text
*.des     filter=lfs diff=lfs merge=lfs -text

